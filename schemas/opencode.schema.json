{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/opencode.schema.json",
  "title": "OpenCode agent registry config",
  "description": "Focused JSON Schema for the parts of opencode.json this repo relies on. Additional top-level and agent-level keys are permitted so future opencode config growth does not break CI.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "default_agent": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/permission"
      }
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/agent"
      }
    }
  },
  "required": ["agents"],
  "additionalProperties": true,
  "definitions": {
    "agent": {
      "type": "object",
      "required": ["mode", "description", "system"],
      "properties": {
        "mode": {
          "enum": ["primary", "subagent", "all"]
        },
        "description": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "request": {
          "type": "object"
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/permission"
          }
        },
        "dynamic": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "permission": {
      "type": "object",
      "required": ["action", "resource", "effect"],
      "properties": {
        "action": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "effect": {
          "enum": ["allow", "deny", "ask"]
        }
      },
      "additionalProperties": false
    }
  }
}
