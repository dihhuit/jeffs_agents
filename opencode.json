{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "provider": {
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle"
        }
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "description": "Decides which and how many agents to launch for a complex task, then orchestrates them",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.2,
      "color": "#a855f7",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "task": {
          "*": "allow"
        },
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow"
      }
    },
    "just-code": {
      "mode": "all",
      "description": "Writes production code. Code must build, lint, and pass tests",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.5,
      "color": "#22c55e",
      "prompt": "{file:./prompts/just-code.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": {
          "research": "allow",
          "*": "deny"
        }
      }
    },
    "test-agent": {
      "mode": "subagent",
      "description": "Writes unit tests, integration tests, e2e tests, fuzz tests. Installs test toolchains as needed",
      "model": "opencode-zen/big-pickle",
      "color": "#ef4444",
      "prompt": "{file:./prompts/test-agent.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": {
          "research": "allow",
          "*": "deny"
        }
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Reviews code for best practices, edge cases, security, threading issues. Signs off on all code changes",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.1,
      "color": "#3b82f6",
      "prompt": "{file:./prompts/code-reviewer.md}",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "grep *": "allow",
          "rg *": "allow"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "deny",
        "task": {
          "research": "allow",
          "*": "deny"
        }
      }
    },
    "architect": {
      "mode": "subagent",
      "description": "Generates design docs, architecture diagrams, API specs to be followed by other agents",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.7,
      "color": "#eab308",
      "prompt": "{file:./prompts/architect.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": {
          "research": "allow",
          "*": "deny"
        }
      }
    },
    "devops": {
      "mode": "subagent",
      "description": "Builds and debugs infrastructure, deploys the stack",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.1,
      "color": "#6b7280",
      "prompt": "{file:./prompts/devops.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": {
          "research": "allow",
          "*": "deny"
        }
      }
    },
    "qa": {
      "description": "Quality assurance expert",
      "mode": "subagent",
      "model": "opencode-zen/big-pickle",
      "prompt": "{file:./prompts/qa.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": false,
        "grep": true,
        "glob": true,
        "webfetch": true,
        "question": true,
        "websearch": true
      }
    },
    "research": {
      "mode": "subagent",
      "description": "Specializes in web search, returning research reports for other agents",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.1,
      "color": "#06b6d4",
      "prompt": "{file:./prompts/research.md}",
      "permission": {
        "websearch": "allow",
        "webfetch": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "todowrite": "deny",
        "task": {
          "*": "deny"
        }
      }
    },
    "ui-ux-designer": {
      "mode": "subagent",
      "description": "Ensures the app looks good and follows UI/UX best practices. Generates mocks, wireframes, and UI flow diagrams",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.8,
      "color": "#f8f9fa",
      "prompt": "{file:./prompts/ui-ux-designer.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "deny",
          "npm run dev": "allow",
          "npx *": "allow"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": {
          "research": "allow",
          "*": "deny"
        }
      }
    }
  }
}
