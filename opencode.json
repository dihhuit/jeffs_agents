{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "provider": {
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle"
        }
      }
    },
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "minimax-m3": { "name": "MiniMax M3" },
        "glm-5.2": { "name": "GLM-5.2" },
        "mimo-v2.5": { "name": "MiMo-V2.5" }
      }
    }
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "description": "Primary coordinator that decomposes tasks and delegates to specialized subagents",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.2,
      "color": "#a855f7",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "task": { "*": "allow" },
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow"
      }
    },
    "just-code": {
      "mode": "all",
      "description": "Writes production code using Go budget model. Code must build, lint, and pass tests",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.5,
      "color": "#22c55e",
      "prompt": "{file:./prompts/just-code.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": { "research": "allow", "*": "deny" }
      }
    },
    "just-code-mid": {
      "mode": "subagent",
      "description": "Writes production code using mid-tier coding-optimized model. Best for complex feature implementation",
      "model": "opencode-go/kimi-k2.7-code",
      "temperature": 0.5,
      "color": "#16a34a",
      "prompt": "{file:./prompts/just-code.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": { "research": "allow", "*": "deny" }
      }
    },
    "just-code-pro": {
      "mode": "subagent",
      "description": "Writes production code using premium model. For complex, architecture-sensitive code requiring deeper reasoning",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.4,
      "color": "#15803d",
      "prompt": "{file:./prompts/just-code.md}",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow",
        "task": { "research": "allow", "*": "deny" }
      }
    },
    "just-code-free": {
      "mode": "subagent",
      "description": "Writes production code using free model. For simple changes, boilerplate, or when Go budget is tight",
      "model": "opencode-zen/big-pickle",
      "temperature": 0.5,
      "color": "#86efac",
      "prompt": "{file:./prompts/just-code.md}",
