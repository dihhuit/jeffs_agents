{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/proc/**",
      "effect": "allow"
    }
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "description": "Primary coordinator that decomposes tasks and delegates to specialized subagents",
      "model": "opencode/big-pickle",
      "color": "#a855f7",
      "system": "{file:./prompts/orchestrator.md}",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "just-code": {
      "mode": "all",
      "description": "Writes production code using Go budget model. Code must build, lint, and pass tests",
      "model": "opencode-go/deepseek-v4.1-flash",
      "color": "#22c55e",
      "system": "{file:./prompts/just-code.md}",
      "request": {
        "body": {
          "temperature": 0.5
        }
      },
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "research",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "just-code-mid": {
      "mode": "subagent",
      "description": "Writes production code using mid-tier coding-optimized model. Best for complex feature implementation",
