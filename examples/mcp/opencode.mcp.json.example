{
  "$schema": "https://opencode.ai/config.json",
  "_notes": [
    "INERT EXAMPLE - the .example suffix keeps opencode from auto-loading this file.",
    "All servers below are disabled (enabled: false). Copy this into .mcp.json (Claude Code)",
    "or merge the \"mcp\" block into opencode.json (OpenCode) and set enabled: true.",
    "NEVER put tokens inline: use {env:VAR} substitution or the client's secret store.",
    "Filesystem is scoped to ./workspace only - do not widen the allowlist.",
    "See docs/mcp.md for the full reference and per-agent scoping table."
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--caps=devtools,network,testing"],
      "enabled": false,
      "timeout": 10000
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "./workspace"],
      "cwd": ".",
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    }
  },
  "tools": {
    "playwright*": false,
    "filesystem*": false,
    "github*": false
  },
  "agent": {
    "qa": {
      "tools": {
        "playwright*": true
      }
    },
    "devops": {
      "tools": {
        "github*": true
      }
    },
    "just-code": {
      "tools": {
        "filesystem*": true
      }
    }
  }
}